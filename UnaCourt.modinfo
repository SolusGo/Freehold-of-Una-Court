  <EntryPoints>
    <EntryPoint type="InGameUIAddin" file="Lua/UnaCourtLoader.lua">
      <Name>Una Court Gameplay Loader</Name>
      <Description>Loads Una Court gameplay systems.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="UI/UnaCourtPanel.xml">
      <Name>Una Court Command Panel</Name>
      <Description>Displays Freehold, Dominion, and Ultimate Possession controls.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="UI/TrentSoftKitty_UI.xml">
      <Name>Soft Kitty Serenade Panel</Name>
      <Description>Audience selection, reward and risk previews, and Hopeless Romantic actions.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="UI/TrentPhoneStealer_UI.xml">
      <Name>Phone Stash Panel</Name>
      <Description>Foreign-capital Phone missions, Stash yields, cooldowns, and returns.</Description>
    </EntryPoint>
    <EntryPoint type="InGameUIAddin" file="Princedom/UI/PrincePanel.xml">
      <Name>Princedom Two Masters Panel</Name>
      <Description>Trent mastery, cooldown and adjacent target selection.</Description>
    </EntryPoint>
  </EntryPoints>
</Mod>